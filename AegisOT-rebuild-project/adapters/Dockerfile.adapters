FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libboost-all-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.adapters.txt .
RUN pip install --no-cache-dir -r requirements.adapters.txt

COPY opcua_adapter.py dnp3_adapter.py ./

EXPOSE 4840 20000
